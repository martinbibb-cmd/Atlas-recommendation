exports[`CustomerPackRendererV1 > renders customer-safe deterministic snapshots for all six canonical templates > template_regular_boiler_vented_cylinder_y_plan 1`] = `"<article class="cprv1-document" data-testid="cprv1-document" data-visual-tokens="customer-pack-v1" data-layout-mode="print-and-portal"><header class="cprv1-cover" data-testid="cprv1-cover"><p class="cprv1-cover__eyebrow">Homeowner heating summary</p><h1 class="cprv1-cover__title">Regular boiler + vented cylinder + Y-plan</h1><p class="cprv1-cover__summary" data-testid="cprv1-recommendation-summary">Locked summary for Regular boiler + vented cylinder + Y-plan</p></header><div class="cprv1-sections"><section class="cprv1-section" data-testid="cprv1-section-home_understanding" aria-labelledby="cprv1-section-heading-home_understanding"><header class="cprv1-section__header"><p class="cprv1-section__eyebrow">Section 1</p><h2 id="cprv1-section-heading-home_understanding" class="cprv1-section__heading">Your home and current heating setup</h2><p class="cprv1-section__summary">A clear overview of how your current system is configured and how it currently operates.</p></header><div class="cprv1-card-grid" data-layout="responsive-metric-cards"><article class="cprv1-card cprv1-card--system_behaviour_story" data-testid="cprv1-card-system_behaviour_story"><header class="cprv1-card__header"><div><h3 class="cprv1-card__title">How your current heating is set up</h3><p class="cprv1-card__summary">Heat source type: gas_boiler.</p></div><span class="cprv1-confidence-badge cprv1-confidence-badge--estimated" data-testid="cprv1-confidence-badge" data-variant="estimated">Estimated from the visible system layout</span></header><dl class="cprv1-metrics" data-testid="cprv1-card-metrics"><div class="cprv1-metrics__item"><dt class="cprv1-metrics__label">Heating circuit evidence</dt><dd class="cprv1-metrics__value">Active circuits during scenario: active_primary_heating_cycle, active_primary_to_store_transfer, active_domestic_cold