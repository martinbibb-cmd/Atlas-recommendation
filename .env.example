VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Temporary local OAuth bypass options:
# Set to 1 to disable Google sign-in UI/flow.
# VITE_GOOGLE_AUTH_DISABLED=1
#
# Set to 1 in local dev to use a mock authenticated Atlas session.
# Useful when testing app flows without OAuth redirects.
# VITE_ATLAS_DEV_MOCK_AUTH=1
